{
  "info": {
    "name": "Perpustakaan Backend API",
    "description": "Library Management System - Microservices API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "API Gateway Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"email\": \"admin@perpustakaan.com\",\n  \"password\": \"admin123\",\n  \"fullName\": \"Admin Perpustakaan\",\n  \"role\": \"admin\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@perpustakaan.com\",\n  \"password\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/profile",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/auth/profile",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Admin Updated\",\n  \"phone\": \"081234567890\"\n}"
            }
          }
        },
        {
          "name": "Get All Users (Admin/Librarian only)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/users",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "limit", "value": "10"}
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get Book by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/books/:bookId",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Create Book (Admin/Librarian)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/books",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Belajar Node.js\",\n  \"author\": \"John Doe\",\n  \"isbn\": \"978-3-16-148410-9\",\n  \"publisher\": \"Gramedia\",\n  \"year\": 2024,\n  \"category\": \"Programming\",\n  \"stock\": 5,\n  \"description\": \"Buku panduan Node.js untuk pemula\"\n}"
            }
          }
        },
        {
          "name": "Update Book (Admin/Librarian)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/books/:bookId",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Belajar Node.js Updated\",\n  \"stock\": 10\n}"
            }
          }
        },
        {
          "name": "Delete Book (Admin/Librarian)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/books/:bookId",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/books/categories",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Get All Transactions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/transactions",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get My Transactions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/transactions/my",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get Transaction by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/transactions/:transactionId",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Borrow Book",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/transactions",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"{{bookId}}\",\n  \"type\": \"borrow\",\n  \"dueDate\": \"2024-12-31\"\n}"
            }
          }
        },
        {
          "name": "Return Book",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/transactions",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"{{bookId}}\",\n  \"type\": \"return\",\n  \"dueDate\": \"2024-12-31\"\n}"
            }
          }
        },
        {
          "name": "Update Transaction Status (Admin/Librarian)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/transactions/:transactionId/status",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            }
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "javascript",
        "exec": [
          "",
          "// Set default token if not set",
          "if (!pm.environment.get('token')) {",
          "    pm.environment.set('token', 'YOUR_TOKEN_HERE');",
          "}",
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "javascript",
        "exec": [
          "// Log response for debugging",
          "console.log('Response:', pm.response.text());",
          ""
        ]
      }
    }
  ]
}