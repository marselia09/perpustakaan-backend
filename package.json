{
  "name": "perpustakaan-backend",
  "version": "1.0.0",
  "description": "Library Management System - Monorepo",
  "private": true,
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:book\" \"npm run dev:transaction\"",
    "dev:gateway": "node gateway/src/index.js",
    "dev:auth": "node services/auth-service/src/index.js",
    "dev:book": "node services/book-service/src/index.js",
    "dev:transaction": "node services/transaction-service/src/index.js",
    "start": "node gateway/src/index.js & node services/auth-service/src/index.js & node services/book-service/src/index.js & node services/transaction-service/src/index.js & wait",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "docker:build": "docker build -t perpustakaan-backend .",
    "docker:run": "docker run -p 3000-3003:3000-3003 --network perpustakaan-network perpustakaan-backend",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "amqplib": "^0.10.3",
    "axios": "^1.16.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}