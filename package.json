{
  "name": "perpustakaan-backend",
  "version": "1.0.0",
  "description": "Library Management System - Monorepo",
  "private": true,
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:book\" \"npm run dev:transaction\"",
    "dev:gateway": "cd gateway && npm run dev",
    "dev:auth": "cd services/auth-service && npm run dev",
    "dev:book": "cd services/book-service && npm run dev",
    "dev:transaction": "cd services/transaction-service && npm run dev",
    "start": "concurrently \"npm run start:gateway\" \"npm run start:auth\" \"npm run start:book\" \"npm run start:transaction\"",
    "start:gateway": "node gateway/src/index.js",
    "start:auth": "node services/auth-service/src/index.js",
    "start:book": "node services/book-service/src/index.js",
    "start:transaction": "node services/transaction-service/src/index.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.1.5",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "amqplib": "^0.10.3",
    "uuid": "^9.0.1",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  }
}